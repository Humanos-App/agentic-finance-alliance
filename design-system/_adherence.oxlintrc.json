{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "doc-page.js",
              "ui_kits/website/**",
              "website-v2/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fill|cream|line|ghost)$/]",
        "message": "<Button> variant must be one of 'fill' | 'cream' | 'line' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|inverse|outline)$/]",
        "message": "<Card> tone must be one of 'surface' | 'inverse' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DinnerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|city|meta|image|imagePosition|next|action|key|ref|className|style|children)$/]",
        "message": "<DinnerCard> doesn't accept that prop. Declared props: tag, city, meta, image, imagePosition, next, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|soft|muted)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'soft' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:lockup|size|assetBase|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: lockup, size, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='lockup'] > Literal[value!=/^(?:green-on-toasted|transparent|cream-transparent)$/]",
        "message": "<Logo> lockup must be one of 'green-on-toasted' | 'transparent' | 'cream-transparent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StripLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|key|ref|className|style|children)$/]",
        "message": "<StripLogo> doesn't accept that prop. Declared props: src, alt, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Point'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|large|key|ref|className|style|children)$/]",
        "message": "<Point> doesn't accept that prop. Declared props: title, text, large."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lede|divider|tone|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: eyebrow, title, lede, divider, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|green)$/]",
        "message": "<Section> tone must be one of 'cream' | 'green'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
