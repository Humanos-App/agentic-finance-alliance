# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Add the same vars to Vercel
# (Project → Settings → Environment Variables) for production.

# Canonical origin used for metadata, the sitemap and the OG card.
# Optional: on Vercel it falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=

# MailerSend transactional API (partner form).
# Token from: app.mailersend.com → Settings → Tokens → "Add token"
# (needs the "Email" sending permission).
MAILERSEND_API_KEY=

# A verified sender address on a domain you've added in MailerSend.
# Must be on a domain you've completed DNS verification for; using an
# unverified domain will return a 422 from the API.
MAILERSEND_FROM_EMAIL=

# Optional. Display name in the "From" line. Defaults to "AFA Website".
MAILERSEND_FROM_NAME=
